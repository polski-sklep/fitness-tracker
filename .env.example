# =============================================================================
# Fitness Tracker — environment variables
# Copy this file to .env and fill in real values. Never commit .env.
# =============================================================================

# --- Telegram ---------------------------------------------------------------
# Create a bot via @BotFather → /newbot → copy the token here
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user ID. DM @userinfobot to find it. Integer, no quotes.
TELEGRAM_ALLOWED_USER_ID=

# --- Anthropic --------------------------------------------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# --- Database ---------------------------------------------------------------
# Inside Docker Compose, the host is `db` (service name).
# For local-host runs against a docker-exposed port, change to localhost:5432.
DATABASE_URL=postgresql+psycopg://fitness:fitness@db:5432/fitness

# --- App config -------------------------------------------------------------
BODYWEIGHT_KG=78
SESSION_MEDIAN_POWER=3161
TZ=Europe/Lisbon

# --- Webapp binding ---------------------------------------------------------
# On the VPS: set WEB_BIND_HOST to the Tailscale IPv4 of the VPS.
# Locally:    leave blank or set to 127.0.0.1.
WEB_BIND_HOST=127.0.0.1
WEB_BIND_PORT=8000
